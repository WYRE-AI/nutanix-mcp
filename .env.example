# Required to start the HTTP bridge. The process logs an error and exits
# non-zero when this is empty or a known placeholder (changeme, secret,
# replace-me, your-s2s-secret, replace-with-a-real-secret, and the other
# example values). Generate with:
#   openssl rand -hex 32
# Never commit a real secret. The value is never logged.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without
# CONDUIT_S2S_SECRET. The server logs a warning, does not check X-Gateway-S2S,
# and binds 127.0.0.1. A non-loopback MCP_HTTP_HOST refuses to start.
# A known placeholder secret still refuses to start when this is set.
# MCP_ALLOW_INSECURE_DEV=1

# Bind address when a real CONDUIT_S2S_SECRET is set. Unset keeps 0.0.0.0,
# the historical container bind. The image and Compose set 0.0.0.0 inside
# the container and publish the host port on 127.0.0.1.
# MCP_ALLOW_INSECURE_DEV=1 ignores a loopback value and binds 127.0.0.1;
# a non-loopback value refuses to start.
# MCP_HTTP_HOST=0.0.0.0

PORT=8080

# Prism Central credentials are not read from the environment. Gateway mode
# requires X-Nutanix-Pc-* headers on each /mcp request. Do not put PC_HOST,
# PC_USERNAME, PC_PASSWORD, or PC_API_KEY in this file for the Compose
# service — Compose does not load this file into the container.
